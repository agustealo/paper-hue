<?xml version="1.0"?>
<ruleset name="Paper Hue Coding Standards">
	<description>WordPress coding and PHP compatibility rules for Paper Hue.</description>

	<arg value="ps"/>
	<arg name="basepath" value="./"/>
	<arg name="parallel" value="8"/>
	<arg name="extensions" value="php"/>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<rule ref="WordPress"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="paper-hue"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="true"/>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="7.4-8.5"/>

	<rule ref="PHPCompatibilityWP"/>

	<!--
		The original public API includes a few short compatibility helpers.
		They are retained intentionally for child themes and existing templates.
		Allow those known prefixes while still enforcing prefixing for new globals.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
		<properties>
			<property name="prefixes" type="array">
				<element value="paper_hue"/>
				<element value="hue"/>
				<element value="get_hue"/>
				<element value="static_fallback"/>
				<element value="get_breadcrumb"/>
			</property>
		</properties>
	</rule>
</ruleset>
