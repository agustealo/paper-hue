<?xml version="1.0"?>
<ruleset name="Paper Hue Coding Standards">
	<description>WordPress coding and PHP compatibility rules for Paper Hue.</description>

	<arg value="ps"/>
	<arg name="basepath" value="./"/>
	<arg name="parallel" value="8"/>
	<arg name="extensions" value="php"/>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<rule ref="WordPress"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="paper-hue"/>
		</properties>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="true"/>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="7.4-8.5"/>

	<rule ref="PHPCompatibilityWP"/>

	<!--
		The original public API includes three unprefixed compatibility helpers.
		They are retained intentionally for child themes and existing templates.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="paper_hue,hue,get_hue,static_fallback,get_breadcrumb"/>
		</properties>
	</rule>
</ruleset>
